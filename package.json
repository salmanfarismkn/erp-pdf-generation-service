{
  "name": "erp-pdf-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/bulk-worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/bulk-worker.js",
    "test": "vitest run",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "dev:outbox": "tsx watch src/worker/outbox-dispatcher.ts",
    "load-test": "node scripts/load-test.mjs",
    "test:large-document": "node scripts/large-document-test.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bullmq": "^6.3.15",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "puppeteer": "^25.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
